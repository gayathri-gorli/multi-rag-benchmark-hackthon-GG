# LLM provider: openrouter | azure_openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Embedding provider: auto | local | mock | openrouter | hf | azure_openai
# auto (default) = already-cached local bge-small (384-d) if present, otherwise a clearly labelled MOCK mode.
# Set openrouter only after your workspace allows the model (currently blocked by a guardrail).
EMBEDDING_PROVIDER=auto
OPENROUTER_EMBEDDING_MODEL=baai/bge-large-en-v1.5
# Only for EMBEDDING_PROVIDER=hf (needs requirements-local-embeddings.txt)
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Azure OpenAI (only when switching providers)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
